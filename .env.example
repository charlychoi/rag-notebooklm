# Streamlit Cloud > App Settings > Secrets 에 아래 값을 입력하세요

OPENAI_API_KEY=sk-proj-...

# Open Notebook (로컬 전용, 클라우드 배포 시 불필요)
OPEN_NOTEBOOK_API_URL=http://127.0.0.1:5055
OPEN_NOTEBOOK_STRATEGY_MODEL=model:...
OPEN_NOTEBOOK_ANSWER_MODEL=model:...
OPEN_NOTEBOOK_FINAL_ANSWER_MODEL=model:...

# Composio (선택)
COMPOSIO_API_KEY=ak_...
COMPOSIO_USER_ID=...
COMPOSIO_CONNECTED_ACCOUNT_ID=ca_...
TARGET_NOTION_PAGE_ID=...
